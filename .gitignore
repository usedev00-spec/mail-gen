**/__pycache__
venv/
build/
dist/
emails.txt
# Per-day export files (emails_DD_MM_YY.txt) — same private aliases as emails.txt.
emails_*.txt
generation_log.jsonl
**/.DS_Store
*.spec

# Multi-account config — real, user-specific, never pushed.
# Only accounts.example.json is tracked.
accounts.json

# Gmail IMAP config for the ban check — holds a Gmail app password.
# Only banscan.example.json is tracked.
banscan.json

# Real per-account cookie files live in cookies/ and are never pushed.
# Only the *.example.txt templates in that folder are tracked (git pull
# brings you the templates; your real files sit alongside, untouched).
cookies/*
!cookies/*.example.txt

# No Markdown file is ever shipped to clients, except the public README
# (the client-facing manual). Private guides/notes stay local, no exception.
*.md
!README.md

# Access-key system — NEVER push these (maintainer only)
license_private_key.pem
keygen.py
issued_keys.json
GUIDE-CLES-PRIVE.md
# Belt and braces: any key material or local env file, whatever the name
# (also covers backup copies like license_private_key.pem.bak).
*.pem
*.pem.*
*.key
.env
.env.*

# Generated CSV exports
*.csv
